<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.kylian.photofilter.FiltersController">
   <children>
      <ScrollPane fitToWidth="true" prefHeight="400.0" prefWidth="300.0" HBox.hgrow="ALWAYS">
         <content>
            <VBox fx:id="filterContainer" alignment="TOP_CENTER" spacing="10.0" style="-fx-background-color: #ededed;">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
      <VBox alignment="CENTER" prefHeight="400.0" prefWidth="250.0" spacing="25.0">
         <children>
            <DatePicker fx:id="datePicker" />
            <Button mnemonicParsing="false" onAction="#addFilter" prefWidth="150.0" text="Ajouter un Filtre" />
            <Button mnemonicParsing="false" onAction="#editSelectedFilter" prefWidth="150.0" text="Modifier le Filtre" />
            <Button mnemonicParsing="false" onAction="#removeSelectedFilter" prefWidth="150.0" text="Supprimer le Filtre" />
            <Button mnemonicParsing="false" onAction="#closeWindow" prefWidth="150.0" text="Fermer" />
         </children>
         <HBox.margin>
            <Insets />
         </HBox.margin>
      </VBox>
   </children>
</HBox>
