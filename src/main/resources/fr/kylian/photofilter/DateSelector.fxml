<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.kylian.photofilter.FiltersController">
   <stylesheets>
      <URL value="@style.css" />
   </stylesheets>
   <children>
      <ScrollPane fitToHeight="true" fitToWidth="true" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="400.0" prefWidth="350.0" HBox.hgrow="ALWAYS">
         <content>
            <VBox fx:id="filterContainer" alignment="TOP_CENTER" spacing="10.0" style="-fx-background-color: transparent;">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
      <VBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="-Infinity" prefHeight="400.0" prefWidth="250.0" spacing="25.0" HBox.hgrow="NEVER">
         <children>
            <Button mnemonicParsing="false" onAction="#addFilter" prefWidth="150.0" text="Ajouter un Filtre" styleClass="button-primary" />
            <Button mnemonicParsing="false" onAction="#editSelectedFilter" prefWidth="150.0" text="Modifier le Filtre" />
            <Button mnemonicParsing="false" onAction="#removeSelectedFilter" prefWidth="150.0" text="Supprimer le Filtre" />
            <Button mnemonicParsing="false" onAction="#closeWindow" prefWidth="150.0" text="Fermer" />
         </children>
         <HBox.margin>
            <Insets />
         </HBox.margin>
      </VBox>
   </children>
</HBox>

